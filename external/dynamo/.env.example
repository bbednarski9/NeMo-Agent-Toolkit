HF_HOME=~/.cache/huggingface

HF_TOKEN=

# Required: Set your model directory path with model weights
DYNAMO_MODEL_DIR=~/models/Llama-3.1-8B-Instruct
# DYNAMO_MODEL_DIR=~/models/Llama-3.3-70B-Instruct
# DYNAMO_MODEL_DIR=~/models/Qwen3-32B

# Set repository directory (for Thompson Sampling router)
DYNAMO_REPO_DIR=~/NeMo-Agent-Toolkit/external/dynamo

# =============================================================================
# OPTIONAL VARIABLES - GPU Configuration
# =============================================================================

# GPU device IDs for unified mode (comma-separated)
# Default: 0,1,2,3
DYNAMO_GPU_DEVICES=0,1,2,3,4,5,6,7

# GPU device IDs for disaggregated mode prefill workers
# Default: 0,1
# DYNAMO_PREFILL_GPUS=0,1

# GPU device IDs for disaggregated mode decode workers
# Default: 2,3
# DYNAMO_DECODE_GPUS=2,3

# Tensor parallelism size (number of GPUs per worker)
# Default: 4 for unified mode, 2 for disaggregated mode
DYNAMO_TP_SIZE=1

DYNAMO_WORKER_COMPONENT=worker # need this set for worker discovery in dynamo >= 0.9.0

ENABLE_KV_AWARE_ROUTING=true

DYNAMO_ENABLE_KV_EVENTS=true # Not supported on sglang, only supported on vllm. TODO: set this explicitly within the startup scripts.

PROCESSOR_OVERHEAD_LOG=true
# =============================================================================
# OPTIONAL VARIABLES - Network Configuration
# =============================================================================

# HTTP port for Dynamo frontend API
# Default: 8000
DYNAMO_HTTP_PORT=8000

# ETCD client port for metadata and discovery
# Default: 2379
# DYNAMO_ETCD_PORT=2379

# ETCD peer port
# Default: 2390
# DYNAMO_ETCD_PEER_PORT=2390

# NATS messaging port
# Default: 4222
# DYNAMO_NATS_PORT=4222

# =============================================================================
# OPTIONAL VARIABLES - Model Configuration
# =============================================================================

# Shared memory size for Docker container
# Default: 16g
# DYNAMO_SHM_SIZE=16g

# =============================================================================
# OPTIONAL VARIABLES - Disaggregated Mode
# =============================================================================

# Bootstrap port for disaggregated mode communication
# Default: 12345
# DYNAMO_DISAGG_BOOTSTRAP_PORT=12345

# Transfer backend for KV cache (nixl, nccl, or gloo)
# Default: nixl
# DYNAMO_DISAGG_TRANSFER_BACKEND=nixl

# =============================================================================
# OPTIONAL VARIABLES - Performance Tuning
# =============================================================================

# Worker initialization timeout (seconds)
# Increase for large models (70B+) or cold starts
# Default: 1800 (30 minutes)
# DYNAMO_WORKER_INIT_TIMEOUT_S=1800

# Block size in tokens — must match across all components:
#   Workers: --page-size    Frontend: --kv-cache-block-size    Router: config.yaml block_size
# The startup script passes this as KV_BLOCK_SIZE env var; the router reads it at startup
# and will warn if config.yaml disagrees.
# Default: 64 tokens per block
DYNAMO_KV_BLOCK_SIZE=16

# Fraction of GPU memory for KV cache (0.0-1.0)
# Reduce to test cache pressure/degradation scenarios
# Default: 0.9 (90% of GPU memory for KV cache)
# DYNAMO_MEM_FRACTION_STATIC=0.5 #  Load weight end. type=LlamaForCausalLM, dtype=torch.bfloat16, avail mem=25.93 GB, mem usage=65.77 GB
# DYNAMO_MEM_FRACTION_STATIC=0.9
DYNAMO_MEM_FRACTION_STATIC=0.5

# warning: setting this will set the number of available kv cache blocks.
# Worker i gets: DYNAMO_NUM_GPU_BLOCKS_OVERRIDE + i * DYNAMO_NUM_GPU_BLOCKS_STEP blocks.
DYNAMO_NUM_GPU_BLOCKS_OVERRIDE=3000
DYNAMO_NUM_GPU_BLOCKS_STEP=1000
# DYNAMO_NUM_GPU_BLOCKS_OVERRIDE=6500
# DYNAMO_NUM_GPU_BLOCKS_STEP=0

# HINT_OVERRIDE_OSL=250
# HINT_OVERRIDE_IAT=250
# HINT_OVERRIDE_TOTAL_REQUESTS=1

REPLAY_LOG_DIR=/workspace/logs/replay
# REPLAY_LOG_DIR=

# Heterogeneous cache sizes (comma-separated, one per worker).
# Each worker gets a different capacity so the bandit can learn per-worker performance.
# Overrides the above when set.
# DYNAMO_NUM_GPU_BLOCKS_OVERRIDE_CSV=4000,8000,12000,16000,20000,24000,28000,32000

# DYNAMO_MAX_MODEL_LENGTH=16384

# vLLM worker option 1: default
# DYNAMO_USE_MULTILRU=false
# DYNAMO_VLLM_IMAGE="nvcr.io/nvidia/ai-dynamo/vllm-runtime:0.7.1"

# DYNAMO_FROM_SOURCE=true # will force script to use processor_multirlu.py and router_multirlu.py
# DYNAMO_IMAGE="dynamo-sglang-source:main"

# DYNAMO_FROM_SOURCE=false
DYNAMO_FROM_SOURCE=true
DYNAMO_IMAGE=dynamo-vllm-source:main
# DYNAMO_SOURCE_DIR=/localhome/local-bbednarski/dynamo
# DYNAMO_IMAGE="dynamo-multi-lru:latest"

# =============================================================================
# OPTIONAL VARIABLES - Replay Logging
# =============================================================================

# Replay logging for post-hoc routing analysis.
# Set to an output directory to enable; unset to disable (zero overhead).
# When enabled, writes routing_decisions.jsonl, routing_feedback.jsonl, and
# run_metadata.json to the specified directory.
# REPLAY_LOG_DIR=/path/to/experiment/comparison/

# =============================================================================
# OPTIONAL VARIABLES - NvExt Feature Flags
# =============================================================================

# Enable cache_control (pin_prefix after generation)
# Requires: --router-mode kv on frontend, --enable-hierarchical-cache on SGLang workers
DYNAMO_ENABLE_CACHE_CONTROL=false

# Enable router output block tracking (uses osl hint for placeholder blocks)
# DYNAMO_ROUTER_TRACK_OUTPUT_BLOCKS=true

# Set router queue threshold (enables latency_sensitivity priority_jump)
# Value: float 0.0-1.0 (e.g. 0.8)
# DYNAMO_ROUTER_QUEUE_THRESHOLD=0.8

# Enable hierarchical cache on SGLang workers (required for cache_control pin_prefix)
DYNAMO_ENABLE_HIERARCHICAL_CACHE=false

# HiCache configuration (only applies when DYNAMO_ENABLE_HIERARCHICAL_CACHE=true)
# CPU pool size as a multiple of GPU KV cache pool (default: 1.0 = same size)
# DYNAMO_HICACHE_RATIO=1.0
# # Write policy: write_through (copy to CPU on insert) or write_back (copy on evict)
# DYNAMO_HICACHE_POLICY=write_through

# =============================================================================
# OPTIONAL VARIABLES - Monitoring (Grafana)
# =============================================================================

# Grafana binds to localhost only by default and requires login (admin/admin).
# To enable anonymous access for local development convenience, uncomment:

# Allow unauthenticated access to Grafana dashboards
# Default: false (login required)
GF_AUTH_ANONYMOUS_ENABLED=true

# Role granted to anonymous users (only applies when anonymous access is enabled)
# Options: Viewer, Editor, Admin
# Default: Viewer
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Hide the login form (use with anonymous access for a seamless experience)
# Default: false (login form shown)
GF_AUTH_DISABLE_LOGIN_FORM=true

# Grafana admin credentials (used when login is enabled)
# Default: admin / admin
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin
